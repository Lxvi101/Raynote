{
  "$schema": "https://raw.githubusercontent.com/nickel-org/json-schema/refs/heads/main/tauri/tauri.conf.schema.json",
  "productName": "LeviNote",
  "version": "0.1.0",
  "identifier": "com.levinote.notes",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "LeviNote",
        "width": 860,
        "height": 640,
        "minWidth": 480,
        "minHeight": 360,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; script-src 'self'; img-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
