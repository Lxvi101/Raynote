# Autogenerated .copyignore. Edit to customize.
# Supports glob patterns and wildcards (same syntax as .gitignore).
#
# Special flags (prefix with @):
#   @include-tree    - Include file/folder tree at the beginning of output

@include-tree

# VCS & editor
.git/
.gitignore
.svn/
.hg/
.idea/
.vscode/

# Python caches
__pycache__/
*.pyc
*.pyo

# Builds & caches
dist/
build/
out/
.cache/
.parcel-cache/
.turbo/
.next/
.nuxt/
.svelte-kit/
coverage/
bin/
obj/
target/

# Dependencies
node_modules/
.yarn/
.pnpm-store/

# Lock files
pnpm-lock.yaml
package-lock.json
yarn.lock
composer.lock
Gemfile.lock
Cargo.lock

# Env & logs
.env
.env.*
*.log
*.lock
yarn-error.log
npm-debug.log

# OS files
.DS_Store
Thumbs.db

# Common binary/generated file extensions
*.vsix
*.ico
*.png
*.jpg
*.jpeg
*.gif
*.pdf
*.zip
*.tar.gz
*.exe
*.dll
*.so
*.dylib

# Ignore this file by default
.copyignore

# From .gitignore
# Tauri
/src-tauri/target/
/src-tauri/Cargo.lock
/src-tauri/.cargo/
/src-tauri/.tauri-build/
/src-tauri/debug.log

# Rust/tauri artifacts
**/*.rs.bk

# Build output
/dist
/out
/build

# Lock files
pnpm-lock.yaml
yarn.lock
package-lock.json

# Node modules
node_modules/

# OS/filesystem
.DS_Store
Thumbs.db

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Env
.env
.env.*

# IDE/editor
.vscode/
.idea/
*.swp

